# ─── ClaimIT Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in real values before starting the server.

# Server port (default: 3000)
PORT=3000

# JWT secret – change to a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_secure_random_string

# ─── SendGrid (Email) ─────────────────────────────────────────────────────────
# Leave blank to disable outgoing email (claims will still be recorded locally)
SENDGRID_API_KEY=
SENDGRID_FROM=no-reply@your-hospital-domain.com
