# ─── ClaimIT Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in real values before starting the server.

# Application Environment (development / production / test)
NODE_ENV=production
HOST=0.0.0.0
PORT=8847
SECRET_PORTAL_PATH=pinky

# JWT Secret – REQUIRED. Must be a long random string (minimum 16 chars, 32+ recommended)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_production_secret

# CORS Allowed Origins (comma-separated list of origins or specific frontend domain)
CORS_ORIGIN=https://claimit.your-hospital-domain.com

# Evidence file uploads storage directory
UPLOAD_DIR=uploads

# Claim business rules limits
MAX_CLAIM_ASSETS=5
MAX_FILE_SIZE_MB=10

# ─── Email Service Provider (SendGrid or Resend) ─────────────────────────────
# The system supports BOTH SendGrid and Resend.
# If neither is specified, the system operates in safe Simulation Mode.

# Option 1: SendGrid (Recommended if you have a SendGrid API Key)
# Sign up / get key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM=no-reply@yourhospital.com

# Option 2: Resend (Alternative)
# Sign up / get key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=onboarding@resend.dev

# ─── AI Service Provider (Groq, OpenRouter, Google Gemini) ───────────────────
# The system supports 100% Free AI tiers with automatic fail-safe fallback to
# deterministic local rules.
#
# Provider priority: groq | openrouter | gemini | local
AI_PROVIDER=groq

# 1. Groq (Free fast inference with Llama 3.3 / Llama 3.1)
# Sign up / get key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. OpenRouter (Free models ending in :free)
# Sign up / get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# 3. Google Gemini (Free tier with generous limits via Google AI Studio)
# Sign up / get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

