# ─── ClaimIT Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in real values before starting the server.

# Application Environment (development / production / test)
NODE_ENV=production
HOST=0.0.0.0
PORT=8847
SECRET_PORTAL_PATH=pinky

# JWT Secret – REQUIRED. Must be a long random string (minimum 16 chars, 32+ recommended)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_production_secret

# CORS Allowed Origins (comma-separated list of origins or specific frontend domain)
CORS_ORIGIN=https://claimit.your-hospital-domain.com

# Evidence file uploads storage directory
UPLOAD_DIR=uploads

# Claim business rules limits
MAX_CLAIM_ASSETS=5
MAX_FILE_SIZE_MB=10

# ─── Resend (Email Notifications) ────────────────────────────────────────────
# Sign up free at https://resend.com to get your API key
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=onboarding@resend.dev

# Read-only source inventory database (used by Sync Inventory.bat)
SOURCE_DB_HOST=
SOURCE_DB_PORT=3306
SOURCE_DB_NAME=stockz
SOURCE_DB_USER=
SOURCE_DB_PASSWORD=
